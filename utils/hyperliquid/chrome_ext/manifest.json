{
  "manifest_version": 3,
  "name": "Hyperliquid Position Analyzer",
  "version": "1.0",
  "description": "Рассчитывает доли и объемы позиций для дельта-нейтральной стратегии 1.66.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
