    const [sqrtPriceX96, tick] = await poolContract.slot0();

    // Математика Uniswap V3 для расчета цены из tick
    // Цена ETH относительно OP = 1.0001 ^ tick
    const priceETHinOP = Math.pow(1.0001, Number(tick));

